{
  "title": "API Gateway — Rate Limiter",
  "uid": "ratelimiter-gateway",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Requests (5m rate)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[5m])) * 60",
          "legendFormat": "req/min"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 500
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          },
          "unit": "reqpm"
        }
      }
    },
    {
      "id": 2,
      "title": "Blocked Requests (5m rate)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{outcome=\"blocked\"}[5m])) * 60",
          "legendFormat": "blocked/min"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "reqpm"
        }
      }
    },
    {
      "id": 3,
      "title": "P99 Request Duration",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(gateway_request_duration_seconds_bucket[5m])) by (le)) * 1000",
          "legendFormat": "P99 latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Block Rate %",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * sum(rate(gateway_requests_total{outcome=\"blocked\"}[5m])) / sum(rate(gateway_requests_total[5m]))",
          "legendFormat": "Block %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Request Rate by Tenant",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[1m])) by (tenant) * 60",
          "legendFormat": "{{tenant}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Blocked Requests by Tenant",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{outcome=\"blocked\"}[1m])) by (tenant) * 60",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Request Latency Heatmap",
      "type": "heatmap",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_request_duration_seconds_bucket[5m])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "description": "Requests per latency bucket (time to first byte). The rows are the histogram buckets the gateway records.",
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "reverse": false
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "exponent": 0.5,
          "fill": "dark-orange",
          "reverse": false
        },
        "cellGap": 1,
        "cellValues": {
          "unit": "reqps"
        },
        "tooltip": {
          "mode": "single",
          "yHistogram": false,
          "showColorScale": false
        },
        "legend": {
          "show": true
        },
        "showValue": "never",
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        }
      }
    },
    {
      "id": 8,
      "title": "Requests by Gateway Instance",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total[1m])) by (instance) * 60",
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "description": "Each gateway replica separately. With docker-compose.distributed.yml the three lines should track each other."
    }
  ]
}
