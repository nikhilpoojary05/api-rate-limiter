# Copy to .env and fill in real values. .env is gitignored — never commit it.

# JWT signing key. Generate a fresh one per environment:
#   openssl rand -base64 48
# Services refuse to start if this is unset, shorter than 32 bytes, or a known
# placeholder key.
JWT_SECRET=

# Database
POSTGRES_DB=ratelimiter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Zipkin
ZIPKIN_URL=http://zipkin:9411/api/v2/spans

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
