# Copy to .env and fill in real values. .env is gitignored — never commit it.

# JWT signing key. Generate a fresh one per environment:
#   openssl rand -base64 48
# Services refuse to start if this is unset, shorter than 32 bytes, or a known
# placeholder key.
JWT_SECRET=

# Database. Bootstrap database for the postgres container; the two application
# databases are created by docker/postgres-init on first start.
POSTGRES_DB=ratelimiter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_AUTH_DB=ratelimiter_auth
POSTGRES_ADMIN_DB=ratelimiter_admin

# Redis. Holds rate limit counters and the published rule set, so it is
# password-protected: unauthenticated write access means an attacker sets
# their own limits.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Browser origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# TLS-dependent settings. Turn BOTH on once TLS terminates in front of the gateway.
# AUTH_COOKIE_SECURE=false sends the refresh cookie in the clear; HSTS enabled
# without working TLS locks browsers out of the host.
AUTH_COOKIE_SECURE=false
SECURITY_HSTS_ENABLED=false

# Zipkin
ZIPKIN_URL=http://zipkin:9411/api/v2/spans

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Local start-all.ps1 only: port for the gateway (default 8080). Compose ignores it.
GATEWAY_PORT=8080
